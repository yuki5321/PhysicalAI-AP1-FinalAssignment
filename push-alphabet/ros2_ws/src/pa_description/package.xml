<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pa_description</name>
  <version>0.1.0</version>
  <description>Push-Alphabet robot description (table, walls, 4 paddles, overhead camera) generated from pa_core/scene.yaml, plus letter and hand Gazebo models.</description>
  <maintainer email="noreply@example.com">push-alphabet</maintainer>
  <license>MIT</license>

  <exec_depend>pa_core</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
  </export>
</package>
