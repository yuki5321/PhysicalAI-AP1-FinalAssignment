# Pose of one letter block on the table, in the world frame of scene.yaml
# (table center at origin, +y = "up" of the letters).
string letter        # "Y", "U", "K", "I", or "" when unknown
float64 x            # [m]
float64 y            # [m]
float64 theta        # [rad], 0 = upright
float32 confidence   # 0..1
